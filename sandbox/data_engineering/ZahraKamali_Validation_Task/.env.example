# Non-secret settings. Copy to .env (it is git-ignored).
# Secrets (API key, DATABASE_URL) go in pass.env instead - see pass.env.example.
# Choose ONE data source (priority: API > PostgreSQL > file).

# Option A: HTTP API (needs DB_API_KEY in pass.env)
DB_API_URL=
# DB_API_PAGE_SIZE=1000

# Option B: direct PostgreSQL (needs DATABASE_URL in pass.env)
# DB_TABLE=
# DB_LIMIT=
# DB_CONNECT_TIMEOUT=15

# Option C: local JSONL file (one JSON object per line)
DB_SOURCE_FILE=fanoos_jobs.jsonl

# Optional
REQUEST_TIMEOUT=30
MAX_REJECT_RATIO=0.5
