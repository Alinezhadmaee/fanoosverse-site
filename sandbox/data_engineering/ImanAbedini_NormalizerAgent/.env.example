# Copy to .env and fill in the keys you actually use.
# Only providers enabled in config/llm.yaml need a key; missing keys for
# backup providers produce a warning, not a crash.

ANTHROPIC_API_KEY=
BACKUP_API_KEY=
LOCAL_API_KEY=

# Optional: point at an alternative llm.yaml
# NORMALIZER_LLM_CONFIG=/absolute/path/to/llm.yaml
