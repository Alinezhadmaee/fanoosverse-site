# =====================================================
# .gitignore - Fanos Normalizer Agent
# =====================================================

# ---------- Secrets / Environment ----------
# API keys must never be pushed. Only .env.example is committed.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Python bytecode ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- Packaging / build artifacts ----------
# (src/fanos_normalizer.egg-info is generated by `pip install -e .`)
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST
*.whl

# ---------- Test / lint / type-check caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover

# ---------- Normalizer runtime data ----------
# SQLite LLM cache (regenerated automatically)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
.cache/
cache_data/

# Logs
*.log
logs/

# Pipeline outputs (generated by `normalizer run`)
output/
outputs/
runs/
tmp/
temp/
normalized*.jsonl
normalized*.json
review_items*.jsonl
review_queue/
candidate_new_skill*.jsonl
candidate_new_skill*.csv

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc ----------
*.bak
*.orig
*.rej
*.tmp

# ---------- Extra rules (user-specified) ----------
src/**/__pycache__/
src/**/*.py[cod]
src/*.egg-info/

# ---------- Source files: DISABLED on purpose ----------
# These are required source code. If ignored, the GitHub repo will be
# broken (ImportError). Uncomment ONLY if you really don't want them pushed.
# src/normalizer_agent/__init__.py
# src/normalizer_agent/vocab/__init__.py
# src/normalizer_agent/validate/__init__.py
# src/normalizer_agent/pipeline/__init__.py
# src/normalizer_agent/interface/__init__.py
# src/normalizer_agent/text/__init__.py
# src/normalizer_agent/cache/__init__.py
# src/normalizer_agent/schemas/__init__.py
# src/normalizer_agent/observability/__init__.py
# src/normalizer_agent/rules/__init__.py
# src/normalizer_agent/llm/__init__.py
# src/normalizer_agent/review/__init__.py
# src/normalizer_agent/llm/providers/__init__.py
# src/normalizer_agent/settings.py
# src/normalizer_agent/startup_check.py