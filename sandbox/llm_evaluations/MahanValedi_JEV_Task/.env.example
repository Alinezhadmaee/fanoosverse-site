# Template for the gatekeeper configuration.
# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Optional no-Docker mode: if set, Qdrant runs inside Python and stores data in this folder
# (QDRANT_URL is then ignored). Use the same folder the ingestion script wrote to.
QDRANT_LOCAL_PATH=
QDRANT_COLLECTION=lantern_sample_collection
QDRANT_TOP_K=3
# Comma-separated payload fields that form the passage text shown to the judge.
# Leave empty to use every payload field. Example: role_normalized,location
QDRANT_TEXT_FIELDS=

# --- Query embedding ---
# Must be the SAME model that was used to index the collection.
EMBEDDING_MODEL=your_embedding_model_name
# Hugging Face token (Read). Required for gated models such as Gemma embeddings.
HF_TOKEN=
# Prefix added before every query (the team's sample uses a Gemma retrieval prefix).
# Keep the quotes so the trailing space is preserved.
EMBEDDING_QUERY_PREFIX="task: search result | query: "

# --- Judge backend: "api" (TypeSafe Jev) or "local" (OpenDecider) ---
JEV_BACKEND=local

# --- API backend (TypeSafe Jev served by DigitalOcean Serverless Inference) ---
# If the key comes directly from TypeSafe (console.typesafe.ai), use
# https://api.typesafe.ai/v1/systemone instead. Check the request format in their docs first.
JEV_API_URL=https://inference.do-ai.run/v1/systemone
JEV_MODEL=typesafe-jev-1.13.0
MODEL_ACCESS_KEY=
JEV_TIMEOUT_SECONDS=30
JEV_MAX_RETRIES=2

# --- Local backend (open-source model) ---
# Use "manjunathshiva/opendecider-small" (4B, needs a 12 GB+ GPU or a 16 GB Apple Silicon Mac)
# or "manjunathshiva/opendecider-nano" (about 400M, much lighter).
LOCAL_MODEL_ID=manjunathshiva/opendecider-nano

# --- Gate logic ---
# A passage passes only if probability is strictly greater than this value.
GATE_THRESHOLD=0.60
NOT_FOUND_MESSAGE=Not Found in Documents
PROMPT_FILE=prompts/judge_instructions.txt
